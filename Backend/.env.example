# .env.example
# Service Management API Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# === Database Configuration (Local PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=project

# === OR use DATABASE_URL (Neon / Vercel Postgres) ===
# DATABASE_URL=postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production

# CORS Configuration
FRONTEND_URL=http://localhost:5173
