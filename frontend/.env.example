# ===================================================
# Frontend Environment Variables
# ===================================================
# Copy this file to .env and fill in the values
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_
# ===================================================

# Backend API Base URL
# --------------------
# For local development: leave empty or comment out to use Vite proxy
#   (Vite proxy is configured in vite.config.js to forward /api to localhost:3000)
#
# For Vercel production: set to your deployed backend URL
#   VITE_API_URL=https://your-backend-app.vercel.app/api/v1
#
VITE_API_URL=